@inherits LayoutComponentBase

<div class="page">
    <NavMenu />

    <main>
        <article class="content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

<style>
    /* ПОВНЕ ОБНУЛЕННЯ СТАНДАРТНИХ ВІДСТУПІВ */
    main {
        flex: 1;
        display: flex;
        flex-direction: column;
        background-color: #000; /* Зафарбовуємо все чорним */
        min-height: 100vh;
    }

    .content {
        padding: 0 !important; /* Прибираємо білі відступи */
    }

    /* Прибираємо старий Sidebar, якщо він прописаний у CSS */
    .sidebar { display: none !important; }
    
    .page {
        display: block !important; /* Вимикаємо flex-row, щоб меню було зверху */
    }
</style>