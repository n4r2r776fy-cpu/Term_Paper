@page "/"
@rendermode InteractiveServer

@* АНІМОВАНИЙ ЗАДНІЙ ФОН (РІДКІ СФЕРИ) *@
<div class="ios-bg-container">
    <div class="glass-sphere sphere-1"></div>
    <div class="glass-sphere sphere-2"></div>
    <div class="glass-sphere sphere-3"></div>
</div>

<div class="container main-content text-center">
    <section class="hero-glass animated-up">
        <h1 class="ios-title">AURUM</h1>
        <p class="ios-subtitle">ESTHETIC EVOLUTION</p>
    </section>

    @* ПРАЙС-ЛИСТ З ЕФЕКТОМ НАВЕДЕННЯ *@
    <div class="row mt-5">
        <div class="col-lg-8 mx-auto">
            <div class="glass-card price-card animated-up-delayed">
                <div class="card-glow"></div>
                <h3 class="gold-text mb-4 fw-light tracking-widest">ПРАЙС-ЛИСТ</h3>
                <div class="price-item"><span>BARBERING</span><span class="price-val">600</span></div>
                <div class="price-item"><span>STYLING</span><span class="price-val">800</span></div>
                <div class="price-item"><span>COLOR</span><span class="price-val">1500</span></div>
                <div class="price-item"><span>VISAGE</span><span class="price-val">1200</span></div>
                <a href="booking" class="ios-btn-glass mt-4">RESERVE NOW</a>
            </div>
        </div>
    </div>

    @* СЕКЦІЯ ПЕРЕВАГ З SVG-МАЛЮНКАМИ *@
    <div class="row mt-5 pt-5 g-4 mb-5">
        @* Картка 1: Стерильність *@
        <div class="col-md-4 reveal">
            <div class="glass-card info-card">
                <svg class="ios-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path stroke-width="1.5" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    <path stroke-width="1.5" d="M9 12l2 2 4-4"/>
                </svg>
                <h5 class="mt-3 gold-text">БЕЗПЕКА</h5>
                <p class="small text-secondary">Повна дезінфекція за протоколами ISO.</p>
            </div>
        </div>

        @* Картка 2: Атмосфера *@
        <div class="col-md-4 reveal">
            <div class="glass-card info-card">
                <svg class="ios-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path stroke-width="1.5" d="M18 8h1a4 4 0 010 8h-1M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4V8z"/>
                    <path stroke-width="1.5" d="M6 1v3M10 1v3M14 1v3"/>
                </svg>
                <h5 class="mt-3 gold-text">АТМОСФЕРА</h5>
                <p class="small text-secondary">Ваш час у супроводі преміум-сервісу.</p>
            </div>
        </div>

        @* Картка 3: Якість *@
        <div class="col-md-4 reveal">
            <div class="glass-card info-card">
                <svg class="ios-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path stroke-width="1.5" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
                <h5 class="mt-3 gold-text">ЯКІСТЬ</h5>
                <p class="small text-secondary">Тільки перевірена світова косметика.</p>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --gold: #d4af37;
        --glass: rgba(255, 255, 255, 0.03);
        --border: rgba(255, 255, 255, 0.08);
    }

    body {
        background: #000;
        font-family: 'Inter', sans-serif;
        color: #fff;
        overflow-x: hidden;
    }

    /* --- АНІМОВАНИЙ ФОН --- */
    .ios-bg-container {
        position: fixed;
        top: 0; left: 0; width: 100%; height: 100%;
        z-index: -1;
        overflow: hidden;
        background: radial-gradient(circle at center, #0a0a0a 0%, #000 100%);
    }

    .glass-sphere {
        position: absolute;
        border-radius: 50%;
        filter: blur(60px);
        opacity: 0.4;
        animation: move 20s infinite alternate;
    }

    .sphere-1 { width: 400px; height: 400px; background: var(--gold); top: -10%; left: -5%; animation-duration: 25s; }
    .sphere-2 { width: 300px; height: 300px; background: #555; bottom: 10%; right: 10%; animation-duration: 18s; }
    .sphere-3 { width: 500px; height: 500px; background: rgba(212, 175, 55, 0.2); top: 40%; left: 30%; }

    @@keyframes move {
        from { transform: translate(0, 0); }
        to { transform: translate(100px, 50px); }
    }

    /* --- ГЕРО СЕКЦІЯ --- */
    .main-content { padding-top: 160px; }
    .ios-title { font-size: 6rem; font-weight: 200; letter-spacing: -3px; }
    .ios-subtitle { letter-spacing: 8px; font-size: 0.8rem; color: var(--gold); }

    /* --- СКЛЯНІ КАРТКИ --- */
    .glass-card {
        background: var(--glass);
        backdrop-filter: blur(25px);
        -webkit-backdrop-filter: blur(25px);
        border: 1px solid var(--border);
        border-radius: 30px;
        padding: 40px;
        position: relative;
        overflow: hidden;
        transition: all 0.5s cubic-bezier(0.2, 1, 0.2, 1);
    }

    /* Ефект при наведенні курсору */
    .glass-card:hover {
        transform: translateY(-10px) scale(1.02);
        border-color: rgba(212, 175, 55, 0.4);
        background: rgba(255, 255, 255, 0.05);
        box-shadow: 0 20px 40px rgba(0,0,0,0.6);
    }

    .info-card:hover .ios-icon {
        transform: scale(1.1) rotate(5deg);
        color: var(--gold);
    }

    /* --- SVG ІКОНКИ --- */
    .ios-icon {
        width: 40px;
        height: 40px;
        color: rgba(255, 255, 255, 0.5);
        transition: all 0.4s ease;
    }

    /* --- ТАБЛИЦЯ --- */
    .price-item {
        display: flex;
        justify-content: space-between;
        padding: 18px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.03);
        font-weight: 200;
    }

    .price-val::after { content: ' ₴'; font-size: 0.8rem; opacity: 0.6; }

    /* --- КНОПКА --- */
    .ios-btn-glass {
        display: inline-block;
        padding: 14px 40px;
        background: rgba(255, 255, 255, 0.9);
        color: #000;
        border-radius: 50px;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.8rem;
        letter-spacing: 1px;
        transition: all 0.3s;
    }

    .ios-btn-glass:hover {
        background: var(--gold);
        box-shadow: 0 0 25px rgba(212, 175, 55, 0.4);
        transform: scale(1.05);
    }

    /* --- СКРОЛ АНІМАЦІЯ --- */
    .reveal {
        animation: revealAnim both;
        animation-timeline: view();
        animation-range: entry 10% cover 30%;
    }

   @@keyframes revealAnim {
    from { opacity: 0; transform: translateY(50px) scale(0.9); }
    to { opacity: 1; transform: translateY(0) scale(1); }
}

@@keyframes move {
    from { transform: translate(0, 0); }
    to { transform: translate(100px, 50px); }
}
</style>