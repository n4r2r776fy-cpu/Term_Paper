@page "/"
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Вхід</PageTitle>

<div class="login-box">
    <h3>Вхід до системи запису</h3>
    <input @bind="username" placeholder="Логін" class="form-control" />
    <input @bind="password" type="password" placeholder="Пароль" class="form-control" />
    <button class="btn btn-primary" @onclick="DoLogin">Увійти</button>
    <p class="text-danger">@errorMessage</p>
</div>

@code {
    private string username = "";
    private string password = "";
    private string errorMessage = "";

    private async Task DoLogin() {
        var response = await Http.PostAsJsonAsync("api/auth/login", new { username, password });
        if (response.IsSuccessStatusCode) {
            // Якщо логін успішний — переходимо на сторінку майстрів
            Navigation.NavigateTo("/masters");
        } else {
            errorMessage = "Помилка входу!";
        }
    }
}