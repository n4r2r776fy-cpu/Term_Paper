@page "/masters"
@using AppointmentSystem.Models
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppointmentSystem.Data.ApplicationDbContext> DbFactory
@rendermode InteractiveServer

@* АНІМОВАНИЙ ФОН *@
<div class="ios-bg-container">
    <div class="glass-sphere sphere-1"></div>
    <div class="glass-sphere sphere-2"></div>
</div>

<div class="container-fluid main-content">
    <header class="text-center mb-5">
        <h1 class="ios-title">MASTERS</h1>
        <p class="ios-subtitle">CRAFTING YOUR IMAGE</p>
    </header>

    @if (doctors == null)
    {
        <div class="text-center mt-5">
            <div class="spinner-border gold-text" role="status"></div>
        </div>
    }
    else
    {
        <div class="row g-5 justify-content-center px-md-5">
            @foreach (var doctor in doctors)
            {
                <div class="col-xl-3 col-lg-4 col-md-6 reveal">
                    <div class="master-card">
                        <div class="master-image-container">
                            <img src="@GetDoctorImage(doctor.Name)" 
                                 alt="@doctor.Name" 
                                 class="master-photo" 
                                 onerror="this.src='https://via.placeholder.com/600x800?text=AURUM+MASTER'" />
                            <div class="photo-overlay"></div>
                        </div>
                        
                        <div class="master-info">
                            <h4 class="gold-text">@doctor.Name.ToUpper()</h4>
                            <p class="specialization">@doctor.Specialization</p>
                            <div class="divider"></div>
                            <p class="bio">@doctor.Bio</p>
                            <a href="booking" class="ios-btn-small">ЗАПИСАТИСЯ</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Doctor>? doctors;

    protected override async Task OnInitializedAsync()
    {
        try 
        {
            using var context = DbFactory.CreateDbContext();
            doctors = await context.Doctors.ToListAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"DB Error: {ex.Message}");
        }
    }

    private string GetDoctorImage(string? name)
    {
        if (string.IsNullOrEmpty(name)) return "https://via.placeholder.com/600x800";

        var n = name.ToLower().Trim();

        return n switch
        {
            "дмитро" => "https://upload.wikimedia.org/wikipedia/commons/8/8d/President_Barack_Obama.jpg",
            "анна"   => "https://images.unsplash.com/photo-1595959183082-7b570b7e08e2?q=80&w=600&auto=format&fit=crop",
            "олена"  => "https://images.unsplash.com/photo-1580618672591-eb180b1a973f?q=80&w=600&auto=format&fit=crop",
            _        => "https://images.unsplash.com/photo-1560250097-0b93528c311a?q=80&w=600&auto=format&fit=crop"
        };
    }
}

<style>
    .ios-bg-container {
        position: fixed; top: 0; left: 0; width: 100%; height: 100%;
        z-index: -1; background: #000; overflow: hidden;
    }
    .glass-sphere { position: absolute; border-radius: 50%; filter: blur(80px); opacity: 0.2; animation: move 20s infinite alternate; }
    .sphere-1 { width: 600px; height: 600px; background: #d4af37; top: -10%; right: -5%; }
    .sphere-2 { width: 500px; height: 500px; background: #333; bottom: -5%; left: -5%; }

    .main-content { padding-top: 80px; padding-bottom: 100px; }
    
    .ios-title { 
        font-size: 8rem; 
        font-weight: 100; 
        letter-spacing: -5px; 
        color: white; 
        margin-bottom: 0;
        line-height: 1;
    }
    
    .ios-subtitle { 
        letter-spacing: 15px; 
        font-size: 0.8rem; 
        color: #d4af37; 
        margin-bottom: 60px;
        opacity: 0.8;
    }

    /* КАРТКА */
    .master-card {
        background: rgba(255, 255, 255, 0.03);
        border-radius: 40px;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.05);
        transition: all 0.8s cubic-bezier(0.165, 0.84, 0.44, 1);
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .master-card:hover {
        transform: translateY(-20px);
        background: rgba(255, 255, 255, 0.07);
        border-color: rgba(212, 175, 55, 0.4);
        box-shadow: 0 30px 60px rgba(0,0,0,0.5);
    }

    .master-image-container {
        position: relative;
        aspect-ratio: 4/5; /* Портретний формат */
        overflow: hidden;
    }

    .master-photo {
        width: 100%; height: 100%; object-fit: cover;
        transition: transform 1.2s ease;
    }

    .master-card:hover .master-photo { transform: scale(1.1); }

    .photo-overlay {
        position: absolute; bottom: 0; left: 0; width: 100%; height: 70%;
        background: linear-gradient(to top, rgba(0,0,0,1) 0%, transparent 100%);
    }

    .master-info {
        padding: 0 30px 40px 30px;
        margin-top: -80px; /* Наїзд на фото */
        position: relative;
        z-index: 5;
        text-align: center;
    }

    .gold-text {
        color: #d4af37;
        font-size: 2rem;
        font-weight: 200;
        letter-spacing: 3px;
        margin-bottom: 5px;
    }

    .specialization {
        color: #888;
        font-size: 0.7rem;
        letter-spacing: 4px;
        text-uppercase;
        margin-bottom: 15px;
    }

    .divider {
        width: 30px; height: 1px; background: rgba(212, 175, 55, 0.5);
        margin: 0 auto 20px auto;
    }

    .bio {
        color: #aaa;
        font-size: 0.85rem;
        line-height: 1.6;
        font-weight: 300;
        margin-bottom: 25px;
        min-height: 60px;
    }

    .ios-btn-small {
        display: inline-block;
        padding: 12px 35px;
        background: #fff;
        color: #000;
        border-radius: 40px;
        font-size: 0.75rem;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.4s;
    }

    .ios-btn-small:hover {
        background: #d4af37;
        transform: scale(1.05);
        box-shadow: 0 10px 20px rgba(212, 175, 55, 0.2);
    }

    /* АНІМАЦІЇ */
    .reveal { animation: revealAnim 1.2s cubic-bezier(0.165, 0.84, 0.44, 1) both; }
    
    @@keyframes revealAnim {
        from { opacity: 0; transform: translateY(50px); }
        to { opacity: 1; transform: translateY(0); }
    }
    
    @@keyframes move { 
        from { transform: translate(0,0); } 
        to { transform: translate(30px, 30px); } 
    }

       /* Адаптивність для мобілок */
    @@media (max-width: 768px) {
        .ios-title { font-size: 4rem; }
        .master-info { margin-top: -60px; }
    }
</style>